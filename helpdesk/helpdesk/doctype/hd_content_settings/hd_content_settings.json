	"fields": [
		{
			"fieldname": "missed_posts_section",
			"fieldtype": "Section Break",
			"label": "Missed Post Alerts",
			"description": "Hourly email when a post's publish time has passed and it is still not Published or Cancelled"
		},
		{
			"fieldname": "enable_missed_post_alerts",
			"fieldtype": "Check",
			"label": "Enable Missed Post Alerts",
			"default": "1"
		},
		{
			"fieldname": "grace_period_minutes",
			"fieldtype": "Int",
			"label": "Grace Period (Minutes)",
			"default": "30",
			"non_negative": 1,
			"description": "How long after the publish time to wait before alerting"
		},
		{
			"fieldname": "notify_post_team",
			"fieldtype": "Check",
			"label": "Notify the Post's Writer, Designer and Marketer",
			"default": "1"
		},
		{
			"fieldname": "column_break_alerts",
			"fieldtype": "Column Break"
		},
		{
			"fieldname": "alert_recipients",
			"fieldtype": "Table MultiSelect",
			"label": "Always Notify",
			"options": "HD Content Alert Recipient"
		},
		{
			"fieldname": "alert_emails",
			"fieldtype": "Small Text",
			"label": "Also Email",
			"description": "Extra addresses, one per line or comma separated"
		},
		{
			"fieldname": "missed_post_template_section",
			"fieldtype": "Section Break",
			"label": "Missed Post Email",
			"collapsible": 1,
			"description": "Placeholders: {title}, {customer}, {channel}, {due_datetime}, {hours_late}, {post_link}. Leave empty to use the default."
		},
		{
			"fieldname": "missed_post_subject",
			"fieldtype": "Data",
			"label": "Subject"
		},
		{
			"fieldname": "missed_post_message",
			"fieldtype": "Text Editor",
			"label": "Message"
		},
		{
			"fieldname": "portal_section",
			"fieldtype": "Section Break",
			"label": "Client Portal",
			"description": "Clients sign in at /content-portal with their contact email and a one-time code"
		},
		{
			"fieldname": "enable_client_portal",
			"fieldtype": "Check",
			"label": "Enable Client Portal",
			"default": "1"
		},
		{
			"fieldname": "portal_code_template_section",
			"fieldtype": "Section Break",
			"label": "Sign-in Code Email",
